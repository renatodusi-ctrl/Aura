OPENAI_API_KEY=
GEMINI_API_KEY=

# VOICE_PROVIDER aceita openai ou gemini.
# Sem a chave do provider escolhido, AURA usa fallback textual local.
VOICE_PROVIDER=openai
PORT=5173
HOST=127.0.0.1
REALTIME_MODEL=gpt-realtime-2.1
REALTIME_VOICE=cedar
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Vindemiatrix
DAILY_ROUTINE_HOUR=8
JOB_HISTORY_RETENTION_DAYS=90
JOB_EXPORT_DIR=
JOB_TIMEOUT_MS=300000
CODEX_TIMEOUT_MS=900000
AURA_LOCAL_READ_ROOTS=
AURA_CODEX_BIN=codex
AURA_GEMINI_BIN=gemini
AURA_GROK_BIN=grok
AURA_OPENROUTER_BIN=openrouter
OPENROUTER_API_KEY=
AURA_GITHUB_REPO=renatodusi-ctrl/Aura
# Opcional se voce nao usar gh auth login local.
GITHUB_TOKEN=
